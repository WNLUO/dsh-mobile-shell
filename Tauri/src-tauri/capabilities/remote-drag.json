{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-window-drag",
  "description": "Let the local remote page drag the macOS window and double-click to maximize, matching the desktop titlebar.",
  "windows": ["main"],
  "platforms": ["macOS"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
