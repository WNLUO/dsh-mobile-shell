{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-HUB",
  "version": "0.1.0",
  "identifier": "com.dsh.mobile",
  "mainBinaryName": "dsh-mobile-shell",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AI-HUB",
        "width": 1280,
        "height": 820,
        "minWidth": 520,
        "minHeight": 600,
        "incognito": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
